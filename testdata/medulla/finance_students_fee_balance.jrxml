<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="fee_balance" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="329bca4b-39cb-46c1-8a50-7a37451fd0b1">
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="349"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="642"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Medulla Shelf DataSource"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="school_id" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<queryString>
		<![CDATA[select s.id , p.first_name , p.last_name , p.other_name , s.admission_number , s.global_number , sc."name" current_class , ss."name" current_stream , invoices.invoiced_total , coalesce(payments.paid_total,0) paid_total , 
coalesce(invoices.invoiced_total,0) - coalesce(payments.paid_total,0) balance   , sch."name" school_name , c.physical_address, c.postal_address
from student s 
inner join person p on p.id = s.person 
inner join school sch on sch.id = s.school 
left join contact c on sch.contact  = c.id 
left join school_class sc on sc.id = s.current_class 
left join school_stream ss on ss.id = s.current_stream 
left join (
	select i.student , sum(ii.amount) invoiced_total
	from invoice i 
	inner join invoice_item ii on i.id = ii.invoice and ii.date_deleted is null 
	where i.date_deleted is null and i.document_status = 'POSTED'
	group by i.student
) invoices on invoices.student = s.id
left join (
	select r.student , sum(r.total) paid_total
	from receipt r 
	where r.date_deleted is null and r.document_status = 'POSTED'
	group by r.student
) payments on payments.student = s.id
where s.school = cast($P{school_id} as uuid) and s.date_deleted is null
and s.student_status = 'ON_GOING' and (coalesce(invoices.invoiced_total,0) - coalesce(payments.paid_total,0)) > 0
order by  sc."position" , sc."name"  , p.first_name , p.last_name , p.other_name]]>
	</queryString>
