<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ClassList" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="cd262332-98e0-4eee-9a43-a50822a3d89f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Medulla Shelf DataSource"/>
	<parameter name="school_id" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<parameter name="class_id" class="java.lang.String"/>
	<parameter name="stream_id" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[select 
s.admission_number , s.admission_date , coalesce(s.global_number,'') global_number,
coalesce(p.first_name,'') || ' ' || coalesce(p.last_name,'') || ' ' ||  coalesce(p.other_name,'') name , sc."name" || ' ' || coalesce(ss."name",'') student_class , 
replace(s.student_status,'_',' ') student_status ,
replace(p.gender,'OTHER','') gender  , sch."name" school_name , c.physical_address, c.postal_address
from student s
inner join person p on p.id = s.person  and p.date_deleted is null
inner join school_class sc on sc.id = s.current_class 
left join school_stream ss on ss.id = s.current_stream 
inner join school sch on sch.id = s.school 
left join contact c on sch.contact  = c.id 
where s.school = cast($P{school_id} as uuid) 
and ($P{class_id} = '00000000-0000-0000-0000-000000000000' or s.current_class = cast($P{class_id} as uuid) )
and ($P{stream_id} = '00000000-0000-0000-0000-000000000000' or s.current_stream  = cast($P{stream_id} as uuid) )
and s.date_deleted is null 
order by sc."position"  , sc."name" || ' ' || coalesce(ss."name",'') ,
coalesce(p.first_name,'') || ' ' || coalesce(p.last_name,'') || ' ' ||  coalesce(p.other_name,'')]]>
	</queryString>
