	<subDataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<queryString>
			<![CDATA[]]>
		</queryString>
	</subDataset>
	<parameter name="school_id" class="java.lang.String"/>
	<parameter name="receipt_id" class="java.lang.String"/>
	<parameter name="logo" class="java.awt.Image"/>
	<queryString language="SQL">
		<![CDATA[select r.school ,r.receipt_date , r.receipt_number , r.total , r.print_count , s.global_number,
trim(trim(coalesce(p.first_name, ' ') || ' ' || coalesce(p.last_name,' ')) || ' ' || coalesce(p.other_name, ' ')) as names, 
trim(trim(coalesce(pg.first_name, ' ') || ' ' || coalesce(pg.last_name,' ')) || ' ' || coalesce(pg.other_name, ' ')) as guardian_names, 
sc."name"  school_name , c.physical_address  , c.postal_address  , c.phone_number ,
pm."name" payment_method , r.payment_reference  , scl.name school_class,
coalesce ((select sum(i.invoice_total) - sum(i.paid_total) from invoice i where i.student = r.student and i.date_deleted is null and i.document_status = 'POSTED'),0) fee_balance,
replace(sc.details->>'payment_instructions', '\n', '<br\>') payment_instructions 
from receipt r
inner join student s on s.id = r.student 
left join school_class scl on scl.id  =r.school_class
inner join person p on p.id = s.person 
left join payment_method pm on pm.id = r.payment_method 
left join guardian g on g.id = r.received_from_guardian 
left join person pg on pg.id = g.person 
inner join school sc on sc.id  = r.school 
inner join contact c on c.id = sc.contact 
where r.id = cast($P{receipt_id} as uuid) and r.date_deleted is null and r.school = cast($P{school_id} as uuid)]]>
	</queryString>
